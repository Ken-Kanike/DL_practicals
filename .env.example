# ============================================================
# DL_practicals environment template
# ============================================================
# Copy this file to .env for local use:
#   Copy-Item .env.example .env        (Windows PowerShell)
#   cp .env.example .env               (Linux / macOS)
#
# No credentials are required to run any notebook in this
# repository. Every dataset is public and is downloaded from a
# URL at runtime. This template only reserves optional slots for
# services you may add later. Leave values empty by default.
# ============================================================

# Reproducibility and TensorFlow logging
PYTHONHASHSEED=42
TF_CPP_MIN_LOG_LEVEL=2

# Optional: Weights & Biases tracking (not used by default)
# WANDB_API_KEY=
# WANDB_PROJECT=dl-practicals

# Optional: Kaggle API (only if you choose to download data from Kaggle)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional: Hugging Face token (not used by default)
# HF_TOKEN=
